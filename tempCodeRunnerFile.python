# truth_table.py

def truth_table():
    print(f"{'A':^5}{'B':^5}{'AND':^7}{'OR':^7}{'NOT A':^7}{'XOR':^7}")
    print("-" * 38)

    values = [True, False]

    for A in values:
        for B in values:
            and_op = A and B
            or_op = A or B
            not_a = not A
            xor_op = A ^ B  # XOR in python

            print(f"{str(A):^5}{str(B):^5}{str(and_op):^7}{str(or_op):^7}{str(not_a):^7}{str(xor_op):^7}")

if __name__ == "__main__":
    truth_table()
